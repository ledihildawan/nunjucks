<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Nunjucks template error routes - interactive preview of all error types with syntax highlighting and suggested fixes">
  <meta name="robots" content="noindex, nofollow">
  <meta name="author" content="Nunjucks">

  <title>Error Routes — Nunjucks engine ({{ total }} error scenarios)</title>

  <meta property="og:title" content="Nunjucks Error Routes - Interactive Preview">
  <meta property="og:description" content="Browse and preview all Nunjucks template error types grouped by engine tier, with syntax highlighting, possible causes, and suggested fixes.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="/errors">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="Nunjucks Error Routes">
  <meta name="twitter:description" content="Interactive preview of all Nunjucks template error types">

  <link rel="canonical" href="/errors">

  <style>
    :root {
      color-scheme: light dark;
      interpolate-size: allow-keywords;

      --color-bg-page: light-dark(oklch(97% 0.01 285), oklch(12% 0.01 285));
      --color-bg-panel: light-dark(oklch(100% 0 0), oklch(18% 0.01 285));
      --color-bg-alt: light-dark(oklch(96% 0.01 285), oklch(22% 0.01 285));
      --color-border: light-dark(oklch(90% 0.01 285), oklch(28% 0.02 285));

      --color-text-primary: light-dark(oklch(20% 0.02 285), oklch(95% 0.01 285));
      --color-text-secondary: light-dark(oklch(45% 0.02 285), oklch(75% 0.01 285));

      --color-error-text: light-dark(oklch(45% 0.2 25), oklch(70% 0.18 25));
      --color-error-hover: light-dark(oklch(35% 0.2 25), oklch(55% 0.18 25));
      --color-error-bg: light-dark(oklch(45% 0.2 25 / 0.12), oklch(70% 0.18 25 / 0.18));

      --color-btn-bg: light-dark(oklch(20% 0.02 285), oklch(90% 0.01 285));
      --color-btn-text: light-dark(oklch(98% 0.01 285), oklch(15% 0.01 285));
      --color-btn-hover: light-dark(oklch(35% 0.02 285), oklch(100% 0 0));

      --color-scrollbar-thumb: light-dark(oklch(65% 0.01 285), oklch(45% 0.02 285));
      --color-scrollbar-track: light-dark(oklch(92% 0.01 285), oklch(20% 0.01 285));

      --scrollbar-width: 8px;

      --sidebar-width: 400px;
      --header-height: 50px;
    }

    *, *::before, *::after { box-sizing: border-box; }
    ::selection { background: oklch(0.55 0.15 285 / 0.3); color: inherit; }
    :root {
      scrollbar-color: var(--color-scrollbar-thumb) var(--color-scrollbar-track);
    }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      margin: 0;
      height: 100vh; display: flex; flex-direction: column;
      background: var(--color-bg-page);
      color: var(--color-text-primary);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    .skip-link {
      position: absolute;
      top: -40px;
      left: 0;
      background: var(--color-bg-panel);
      color: var(--color-text-primary);
      padding: 8px 16px;
      z-index: 100;
      text-decoration: none;
      font-weight: 500;
      transition: top 0.2s;
    }
    .skip-link:focus {
      top: 0;
      outline: 2px solid var(--color-error-text);
      outline-offset: -2px;
    }

    .sr-only {
      position: absolute;
      width: 1px; height: 1px;
      padding: 0; margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .header {
      height: var(--header-height); padding: 0 20px;
      border-bottom: 1px solid var(--color-border);
      background: var(--color-bg-panel);
      display: flex; align-items: center; gap: 20px;
      flex-shrink: 0;
    }
    h1 { font-size: 16px; margin: 0; color: var(--color-text-primary); font-weight: 600; }
    .header-hint { color: var(--color-text-secondary); font-size: 12px; }
    .tier-legend {
      display: inline-flex;
      gap: 12px;
      margin-left: auto;
      font-size: 11px;
      color: var(--color-text-secondary);
    }
    .tier-legend span { display: inline-flex; align-items: center; gap: 4px; }
    .tier-legend .dot { width: 8px; height: 8px; border-radius: 50%; }
    .tier-legend .dot[data-tier="tier 1"] { background: oklch(70% 0.18 145); }
    .tier-legend .dot[data-tier="tier 2"] { background: oklch(75% 0.18 75); }
    .tier-legend .dot[data-tier="tier 3"] { background: oklch(70% 0.2 25); }

    .header-btn {
      display: flex; align-items: center; justify-content: center;
      width: 28px; height: 28px;
      background: transparent; color: var(--color-text-secondary);
      border: none; border-radius: 6px; cursor: pointer;
      transition: background-color 0.15s, color 0.15s;
      text-decoration: none;
    }
    .header-btn:hover { background: var(--color-bg-alt); color: var(--color-text-primary); }
    .header-btn svg { width: 18px; height: 18px; }

    .header-right {
      margin-left: auto;
      display: flex; align-items: center;
    }

    .credit {
      text-align: center;
      font-size: 12px;
      color: var(--color-text-secondary);
    }
    .credit a {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--color-text-secondary);
      text-decoration: none;
      transition: color 0.15s;
    }
    .credit-by {
      opacity: 0.7;
    }
    .credit-avatar {
      width: 24px; height: 24px;
      border-radius: 50%;
    }
    .credit-name {
      font-weight: 500;
    }
    .credit a:hover { color: var(--color-text-primary); }
    .credit a:hover .credit-by { opacity: 1; }

    code {
      font-family: ui-monospace, 'SFMono-Regular', Consolas, monospace;
      font-size: 0.85em;
    }

    .item-desc {
      display: block;
      color: var(--color-text-secondary);
      font-size: 12px;
      margin-top: 2px;
    }

    li {
      margin: 8px 0;
      line-height: 1.4;
      list-style: none;
    }

    li.hidden { display: none; }

    .error-card {
      display: block;
      width: 100%;
      text-decoration: none;
      color: var(--color-error-text);
      padding: 2px 4px;
      margin: -2px -4px;
      border-radius: 0.375rem;
      transition: background-color 0.2s ease-out, outline 0.2s ease-out;
      scroll-margin-top: 144px;
    }

    .error-card:hover {
      background: var(--color-bg-alt);
    }

    .error-card.active {
      background: var(--color-error-bg);
      outline: 2px solid var(--color-error-text);
      outline-offset: -2px;
    }

    .no-results {
      padding: 24px 15px;
      text-align: center;
      color: var(--color-text-secondary);
    }

    main {
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }
    .no-results p {
      margin: 8px 0;
      font-size: 13px;
    }

    .group.hidden { display: none; }

    .container {
      display: flex; flex: 1; overflow: hidden;
    }

    @property --scroll-mask-t-from {
      syntax: "<length-percentage>";
      inherits: false;
      initial-value: 100%;
    }

    @property --scroll-mask-b-from {
      syntax: "<length-percentage>";
      inherits: false;
      initial-value: 90%;
    }

    @keyframes scroll-mask-y {
      0% {
        --scroll-mask-t-from: 100%;
      }
      10%, 100% {
        --scroll-mask-t-from: var(--scroll-mask-fade-from-t, 92%);
      }
      0%, 90% {
        --scroll-mask-b-from: var(--scroll-mask-fade-from-b, 92%);
      }
      100% {
        --scroll-mask-b-from: 100%;
      }
    }

    .sidebar {
      width: var(--sidebar-width);
      max-width: min(600px, calc(100% - 400px));
      border-right: 1px solid var(--color-border);
      flex-shrink: 0;
      background: var(--color-bg-panel);
      display: flex;
      flex-direction: column;
      position: relative;
      height: 100%;
      min-height: 0;
    }

    .sidebar-header {
      flex-shrink: 0;
    }

    #search-input {
      width: 100%;
      padding: 12px 15px;
      font-size: 13px;
      font-family: inherit;
      background: var(--color-bg-panel);
      border: none;
      border-bottom: 1px solid var(--color-border);
      color: var(--color-text-primary);
      outline: none;
    }

    #search-input::placeholder { color: var(--color-text-secondary); }

    #search-input:focus {
      background: var(--color-bg-alt);
    }

    .sidebar-footer {
      padding: 15px;
      border-top: 1px solid var(--color-border);
      background: var(--color-bg-panel);
      flex-shrink: 0;
    }

    .resize-handle {
      position: absolute;
      right: 0;
      top: 0;
      bottom: 0;
      width: 8px;
      cursor: col-resize;
      background: transparent;
      transition: background-color 0.2s;
    }

    .resize-handle:hover,
    .resize-handle.dragging {
      background: var(--color-error-text);
    }

    .sidebar-content {
      flex: 1;
      overflow-y: auto;
      padding: 15px;
      scrollbar-width: thin;
      scrollbar-color: var(--color-scrollbar-thumb) var(--color-scrollbar-track);

      --scroll-mask-fade-from-t: 92%;
      --scroll-mask-fade-from-b: 92%;

      mask-image:
        linear-gradient(to top, var(--color-bg-panel), var(--color-bg-panel) var(--scroll-mask-t-from), transparent),
        linear-gradient(to bottom, var(--color-bg-panel), var(--color-bg-panel) var(--scroll-mask-b-from), transparent);
      mask-composite: intersect;
      animation: scroll-mask-y linear;
      animation-timeline: scroll(self block);
    }

    .sidebar-content::-webkit-scrollbar { width: var(--scrollbar-width); }
    .sidebar-content::-webkit-scrollbar-track { background: transparent; }
    .sidebar-content::-webkit-scrollbar-thumb {
      background-color: var(--color-scrollbar-thumb);
      border-radius: 9999px;
    }

    .preview {
      flex: 1; display: none; overflow: auto;
      background: var(--color-bg-page);
    }
    .preview.active { display: flex; flex-direction: column; }

    .preview-header {
      display: flex; align-items: center; gap: 8px;
      padding: 6px 12px;
      background: var(--color-bg-panel);
      border-bottom: 1px solid var(--color-border);
      flex-shrink: 0;
    }
    .preview-label {
      display: flex; align-items: center; gap: 6px;
      color: var(--color-text-secondary); font-size: 12px; font-weight: 500;
      flex-shrink: 0;
    }
    .preview-label svg { opacity: 0.6; }
    .preview-url {
      flex: 1; font-size: 12px; font-family: ui-monospace, monospace;
      color: var(--color-text-primary);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      background: var(--color-bg-alt); padding: 4px 8px; border-radius: 4px;
      display: flex; align-items: center; gap: 8px;
    }
    .url-text {
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      flex: 1;
    }
    .preview-btn {
      display: flex; align-items: center; justify-content: center;
      width: 28px; height: 28px;
      background: transparent; color: var(--color-text-secondary);
      border: none; border-radius: 4px; cursor: pointer;
      transition: background-color 0.15s, color 0.15s;
      flex-shrink: 0;
    }
    .preview-btn:hover { background: var(--color-bg-alt); color: var(--color-text-primary); }
    .preview-btn.refresh { margin-left: auto; }
    iframe { flex: 1; border: none; width: 100%; }

    .group { margin-bottom: 10px; container-type: inline-size; }
    .group:first-of-type { margin-top: 0; }
    .group:last-of-type { margin-bottom: 0; }
    .group-header {
      font-size: 14px; color: var(--color-text-secondary); margin: 15px 0 10px;
      border-bottom: 1px solid var(--color-border); padding-bottom: 5px;
      cursor: pointer; user-select: none;
      display: flex; align-items: center; gap: 8px;
      transition: color 0.2s ease-out;
    }
    .group:first-of-type .group-header { margin-top: 0; }
    .group-header:hover { color: var(--color-text-primary); }
    .group-header::before { content: '▶'; font-size: 10px; transition: transform 0.2s; flex-shrink: 0; }
    .group-header.open::before { transform: rotate(90deg); }
    .group-title { text-wrap: balance; word-break: break-word; }
    .group-header .count { color: var(--color-text-secondary); font-weight: normal; flex-shrink: 0; }
    .group-header .tier {
      font-size: 11px;
      padding: 2px 8px;
      border-radius: 9999px;
      font-weight: 500;
      letter-spacing: 0.02em;
      flex-shrink: 0;
    }
    .group-header .tier[data-tier="tier 1"] {
      background: oklch(70% 0.15 145 / 0.18);
      color: oklch(45% 0.18 145);
    }
    .group-header .tier[data-tier="tier 2"] {
      background: oklch(80% 0.15 85 / 0.2);
      color: oklch(45% 0.16 60);
    }
    .group-header .tier[data-tier="tier 3"] {
      background: oklch(70% 0.18 25 / 0.15);
      color: oklch(45% 0.2 25);
    }
    .group-header .tier[data-tier="—"] {
      background: var(--color-bg-alt);
      color: var(--color-text-secondary);
    }
    ul { list-style: none; padding: 0; margin: 0; display: none; }
    ul.open { display: block; }
    ul li:first-child { margin-top: 0; }
    ul li:last-child { margin-bottom: 0; }

    @container (max-width: 180px) {
      .group-header { flex-wrap: wrap; gap: 4px; }
    }

    @media (max-width: 900px) {
      :root { --sidebar-width: 100%; }
      .container { flex-direction: column; }
      .sidebar { width: 100%; border-right: none; border-bottom: 1px solid var(--color-border); }
      .preview { display: none !important; }
      .resize-handle { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
    }
  </style>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <header class="header" role="banner">
    <h1>Error Routes</h1>
    <span class="header-hint">Browse {{ total }} error types grouped by engine tier</span>
    <div class="tier-legend" aria-label="Engine tier legend">
      <span><span class="dot" data-tier="tier 1"></span>tier 1 — recoverable inline</span>
      <span><span class="dot" data-tier="tier 2"></span>tier 2 — recoverable render-time</span>
      <span><span class="dot" data-tier="tier 3"></span>tier 3 — fatal</span>
    </div>
  </header>

  <main id="main-content" role="main">
    <div class="container">
      <aside class="sidebar" aria-label="Error routes list">
        <div class="sidebar-header" role="search">
          <input
            type="search"
            id="search-input"
            role="searchbox"
            placeholder="Filter by name, path, or description..."
            aria-label="Search error routes"
            aria-controls="error-list"
            autocomplete="off"
            spellcheck="false"
          >
        </div>
        <p id="results-count" class="sr-only" aria-live="polite" aria-atomic="true"></p>
        <div class="sidebar-content">
        {% for group in groups %}
        <section class="group" aria-labelledby="group-heading-{{ loop.index }}">
          <h2 class="group-header open" id="group-heading-{{ loop.index }}" data-group="{{ loop.index }}" data-original-count="{{ group.items.length }}" role="heading" aria-level="2">
            <span class="group-title">{{ group.name }}</span>
            <span class="tier" data-tier="{{ group.tier }}" aria-label="Engine tier {{ group.tier }}">{{ group.tier }}</span>
            <span class="count">({{ group.items.length }})</span>
          </h2>
          <ul class="open" id="group-{{ loop.index }}" role="list" aria-label="Error routes in {{ group.name }}">
            {% for item in group.items %}
            <li role="listitem">
              <a href="/errors/{{ item.path }}" class="error-card" data-path="{{ item.path }}" data-desc="{{ item.desc }}" aria-label="{{ item.desc }} - {{ item.path }}">
                <code>{{ item.path }}</code>
                <span class="item-desc">{{ item.desc }}</span>
              </a>
            </li>
            {% endfor %}
          </ul>
        </section>
        {% endfor %}
      </div>
      <footer class="sidebar-footer">
        <div class="credit">
          <a href="https://github.com/ledihildawan" target="_blank" rel="noopener noreferrer">
            <span class="credit-by">by</span>
            <img class="credit-avatar" src="https://github.com/ledihildawan.png" alt="avatar" width="24" height="24">
            <span class="credit-name">ledihildawan</span>
          </a>
        </div>
      </footer>
      <div class="resize-handle" id="resize-handle" role="separator" aria-orientation="vertical" aria-label="Resize sidebar" tabindex="0"></div>
    </aside>

    <div class="preview" id="preview" role="region" aria-label="Error preview" aria-live="polite">
      <header class="preview-header">
        <span class="preview-label">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          Preview
        </span>
        <span class="preview-url" id="preview-url" aria-live="off">
          <span class="url-text"></span>
          <button class="preview-btn refresh" type="button" id="refresh-preview" aria-label="Refresh preview">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
          </button>
        </span>
        <button class="header-btn" type="button" id="theme-toggle" aria-label="Toggle theme" title="Toggle theme">
          <svg id="theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707"/>
            <circle cx="12" cy="12" r="4"/>
          </svg>
        </button>
        <button class="preview-btn" type="button" id="open-preview-tab" aria-label="Open in new tab">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </button>
      </header>
      <iframe id="preview-frame" src="about:blank" title="Error preview" aria-label="Error preview frame"></iframe>
    </div>
  </main>

  <script>
    // Data from Nunjucks SSR
    const groupsData = {{ groups |> tojson }};
    const total = {{ total }};

    const preview = document.getElementById('preview');
    const previewFrame = document.getElementById('preview-frame');
    const previewUrl = document.getElementById('preview-url');
    const urlText = previewUrl.querySelector('.url-text');
    const refreshBtn = previewUrl.querySelector('.refresh');
    const searchInput = document.getElementById('search-input');
    const resizeHandle = document.getElementById('resize-handle');
    const sidebar = document.querySelector('.sidebar');
    const sidebarContent = document.querySelector('.sidebar-content');
    let currentUrl = '';
    let activeLink = null;

    let isResizing = false;
    let startX = 0;
    let startWidth = 0;
    let rafId = null;

    // Theme toggle with localStorage persistence (3-state: system, dark, light)
    const themeToggle = document.getElementById('theme-toggle');
    const themeIcon = document.getElementById('theme-icon');
    const THEME_KEY = 'errors-theme';
    const THEMES = ['system', 'dark', 'light'];
    const THEME_ICONS = {
      system: '<circle cx="12" cy="12" r="9"/><path d="M12 3v18"/><path d="M12 3a9 9 0 0 1 0 18" fill="currentColor" stroke="none" opacity="0.3"/>',
      dark: '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>',
      light: '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>'
    };

    function applyTheme(theme) {
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (theme === 'system') {
        document.documentElement.style.colorScheme = prefersDark ? 'dark' : 'light';
      } else {
        document.documentElement.style.colorScheme = theme;
      }
      localStorage.setItem(THEME_KEY, theme);
      themeIcon.innerHTML = THEME_ICONS[theme];
    }

    function toggleTheme() {
      const current = localStorage.getItem(THEME_KEY) || 'system';
      const idx = THEMES.indexOf(current);
      const next = THEMES[(idx + 1) % THEMES.length];
      applyTheme(next);
    }

    const savedTheme = localStorage.getItem(THEME_KEY) || 'system';
    applyTheme(savedTheme);

    themeToggle.addEventListener('click', toggleTheme);

    document.getElementById('refresh-preview').addEventListener('click', refreshPreview);
    document.getElementById('open-preview-tab').addEventListener('click', openInNewTab);

    function debounce(fn, delay) {
      let timeoutId;
      return function(...args) {
        clearTimeout(timeoutId);
        timeoutId = setTimeout(() => fn.apply(this, args), delay);
      };
    }

    function refreshPreview() {
      if (currentUrl) {
        previewFrame.src = currentUrl;
      }
    }

    // Filter groups by query — matches against the group name (keeps all items)
    // or against individual item path/desc.
    function filterGroups(data, query) {
      return data
        .map(group => {
          if (group.name.toLowerCase().includes(query)) {
            return group;
          }
          return {
            ...group,
            items: group.items.filter(item =>
              item.path.toLowerCase().includes(query) ||
              item.desc.toLowerCase().includes(query)
            )
          };
        })
        .filter(group => group.items.length > 0);
    }

    function renderGroups(data) {
      const fragment = document.createDocumentFragment();

      data.forEach((group, gIdx) => {
        const section = document.createElement('section');
        section.className = 'group';
        section.setAttribute('aria-labelledby', `group-heading-${gIdx + 1}`);

        const header = document.createElement('h2');
        header.className = 'group-header open';
        header.id = `group-heading-${gIdx + 1}`;
        header.dataset.group = gIdx + 1;
        header.dataset.originalCount = group.items.length;
        header.setAttribute('role', 'heading');
        header.setAttribute('aria-level', '2');
        const titleSpan = document.createElement('span');
        titleSpan.className = 'group-title';
        titleSpan.textContent = group.name;
        const tierSpan = document.createElement('span');
        tierSpan.className = 'tier';
        tierSpan.dataset.tier = group.tier;
        tierSpan.setAttribute('aria-label', `Engine tier ${group.tier}`);
        tierSpan.textContent = group.tier;
        const countSpan = document.createElement('span');
        countSpan.className = 'count';
        countSpan.textContent = `(${group.items.length})`;
        header.appendChild(titleSpan);
        header.appendChild(tierSpan);
        header.appendChild(countSpan);
        section.appendChild(header);

        const ul = document.createElement('ul');
        ul.className = 'open';
        ul.id = `group-${gIdx + 1}`;
        ul.setAttribute('role', 'list');
        ul.setAttribute('aria-label', `Error routes in ${group.name}`);

        group.items.forEach(item => {
          const li = document.createElement('li');
          li.setAttribute('role', 'listitem');

          const code = document.createElement('code');
          code.textContent = item.path;

          const descSpan = document.createElement('span');
          descSpan.className = 'item-desc';
          descSpan.textContent = item.desc;

          const a = document.createElement('a');
          a.href = `/errors/${item.path}`;
          a.className = 'error-card';
          a.dataset.path = item.path;
          a.dataset.desc = item.desc;
          a.setAttribute('aria-label', `${item.desc} - ${item.path}`);
          a.appendChild(code);
          a.appendChild(descSpan);

          li.appendChild(a);
          ul.appendChild(li);
        });

        section.appendChild(ul);
        fragment.appendChild(section);
      });

      sidebarContent.appendChild(fragment);
    }

    function showNoResults(query) {
      const existing = document.getElementById('no-results');
      if (existing) {
        existing.querySelector('strong').textContent = `"${query}"`;
        return;
      }
      const el = document.createElement('div');
      el.id = 'no-results';
      el.className = 'no-results';
      el.setAttribute('role', 'status');
      el.setAttribute('aria-live', 'polite');
      const noResultsMessage = document.createElement('p');
      noResultsMessage.appendChild(document.createTextNode('No error routes match '));
      const strong = document.createElement('strong');
      strong.textContent = `"${query}"`;
      noResultsMessage.appendChild(strong);
      const noResultsHint = document.createElement('p');
      noResultsHint.textContent = 'Try different keywords or browse all routes.';
      el.appendChild(noResultsMessage);
      el.appendChild(noResultsHint);
      sidebarContent.appendChild(el);
    }

    function hideNoResults() {
      const existing = document.getElementById('no-results');
      if (existing) existing.remove();
    }

    resizeHandle.addEventListener('mousedown', (e) => {
      e.preventDefault();
      isResizing = true;
      startX = e.clientX;
      startWidth = sidebar.offsetWidth;
      resizeHandle.classList.add('dragging');
      document.body.style.cursor = 'col-resize';
      document.body.style.userSelect = 'none';
      previewFrame.style.pointerEvents = 'none';
    });

    function onMouseMove(e) {
      if (!isResizing) return;
      if (rafId) return;
      rafId = requestAnimationFrame(() => {
        rafId = null;
        if (!isResizing) return;
        const diff = e.clientX - startX;
        const containerWidth = document.querySelector('.container').offsetWidth;
        const maxW = Math.min(600, containerWidth - 400);
        const newWidth = Math.min(maxW, Math.max(200, startWidth + diff));
        sidebar.style.width = newWidth + 'px';
      });
    }

    function onMouseUp() {
      if (!isResizing) return;
      isResizing = false;
      if (rafId) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
      resizeHandle.classList.remove('dragging');
      document.body.style.cursor = '';
      document.body.style.userSelect = '';
      previewFrame.style.pointerEvents = '';
    }

    document.addEventListener('mousemove', onMouseMove);
    document.addEventListener('mouseup', onMouseUp);

    // WHY: event delegation on the stable sidebarContent parent. The search
    // filter rebuilds the list DOM on every query, which detaches any listener
    // bound directly to .error-card / .group-header nodes. Delegating from the
    // parent keeps clicks working across re-renders without re-attaching.
    function selectErrorCard(card) {
      if (activeLink) activeLink.classList.remove('active');
      activeLink = card;
      activeLink.classList.add('active');
      const path = card.dataset.path;
      currentUrl = '/errors/' + path;
      preview.classList.add('active');
      urlText.textContent = currentUrl;
      previewFrame.src = currentUrl;
      location.hash = 'preview=' + currentUrl;
    }

    sidebarContent.addEventListener('click', (e) => {
      const card = e.target.closest('.error-card');
      if (card) {
        e.preventDefault();
        selectErrorCard(card);
        return;
      }
      const header = e.target.closest('.group-header');
      if (header) {
        const index = header.dataset.group;
        const list = document.getElementById('group-' + index);
        if (list) {
          header.classList.toggle('open');
          list.classList.toggle('open');
        }
      }
    });

    function openInNewTab() {
      if (currentUrl) window.open(currentUrl, '_blank');
    }

    if (location.hash.startsWith('#preview=')) {
      const url = location.hash.slice('#preview='.length);
      const path = url.replace('/errors/', '');
      // WHY: CSS.escape — the fragment is external input interpolated into a selector;
      // unescaped it can throw a SyntaxError or select an unintended node.
      const card = document.querySelector('a[data-path="' + CSS.escape(path) + '"]');
      if (card) {
        selectErrorCard(card);
        card.scrollIntoView();
      }
    }

    searchInput.addEventListener('input', debounce((e) => {
      const query = e.target.value.toLowerCase().trim();
      const resultsCount = document.getElementById('results-count');

      sidebarContent.innerHTML = '';

      if (query === '') {
        renderGroups(groupsData);
        hideNoResults();
        resultsCount.textContent = `Showing all ${total} error routes`;
        return;
      }

      const filtered = filterGroups(groupsData, query);

      if (filtered.length > 0) {
        renderGroups(filtered);
        hideNoResults();
        const visibleTotal = filtered.reduce((sum, g) => sum + g.items.length, 0);
        resultsCount.textContent = `Showing ${visibleTotal} of ${total} error routes matching "${query}"`;
      } else {
        showNoResults(query);
        resultsCount.textContent = `Showing 0 of ${total} error routes matching "${query}"`;
      }

    }, 250));

    document.getElementById('results-count').textContent = `Showing all ${total} error routes`;
  </script>
</body>
</html>
