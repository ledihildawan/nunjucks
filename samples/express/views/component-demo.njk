{% extends "base.njk" %}

{% block content %}
<h2>Component Demo</h2>
<p>Welcome, {{ username }}!</p>

<h3>User Cards:</h3>
<div class="user-card">
  <h4>{{ username }}</h4>
  <span class="status status-active">Active</span>
</div>
<div class="user-card">
  <h4>Jane</h4>
  <span class="status status-inactive">Inactive</span>
</div>
<div class="user-card">
  <h4>Bob</h4>
  <span class="status status-active">Active</span>
</div>

<h3>Simple List:</h3>
<ul class="simple-list">
  {% for item in ["One", "Two", "Three"] %}<li>{{ item }}</li>{% endfor %}
</ul>
{% endblock %}
