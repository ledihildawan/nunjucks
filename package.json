{
  "name": "nunjucks",
  "description": "A powerful templating engine with inheritance, asynchronous control, and more (jinja2 inspired)",
  "version": "4.0.0",
  "author": "James Long <longster@gmail.com>",
  "type": "module",
  "workspaces": [
    "packages/@nunjucks/lib",
    "packages/@nunjucks/shared",
    "packages/@nunjucks/error-catalog",
    "packages/@nunjucks/error-renderer",
    "packages/@nunjucks/error-formatter",
    "packages/@nunjucks/lexer",
    "packages/@nunjucks/nodes",
    "packages/@nunjucks/parser",
    "packages/@nunjucks/transformers",
    "packages/@nunjucks/compiler",
    "packages/@nunjucks/runtime",
    "packages/@nunjucks/filters",
    "packages/@nunjucks/core",
    "packages/@nunjucks/loaders",
    "packages/@nunjucks/integrations",
    "packages/@nunjucks/validators",
    "samples/express",
    "samples/vanilla-ts"
  ],
  "dependencies": {
    "@nunjucks/lib": "workspace:*",
    "@nunjucks/core": "workspace:*",
    "@nunjucks/lexer": "workspace:*",
    "@nunjucks/nodes": "workspace:*",
    "@nunjucks/shared": "workspace:*",
    "@nunjucks/transformers": "workspace:*",
    "@nunjucks/compiler": "workspace:*",
    "@nunjucks/runtime": "workspace:*",
    "@nunjucks/filters": "workspace:*",
    "@nunjucks/loaders": "workspace:*",
    "@nunjucks/integrations": "workspace:*",
    "@nunjucks/validators": "workspace:*",
    "picocolors": "^1.1.1",
    "remeda": "^2.39.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/express": "^5.0.6",
    "typescript": "7.0.2"
  },
  "private": true,
  "scripts": {
    "build": "bun run scripts/bundle.js",
    "lint": "biome lint packages samples bench",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "bench": "bun run bench/render.bench.ts",
    "coverage": "bun test --coverage"
  },
  "keywords": [
    "template",
    "templating"
  ],
  "license": "BSD-2-Clause"
}
