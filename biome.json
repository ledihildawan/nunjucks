{
	"$schema": "https://biomejs.dev/schemas/latest/schema.json",
	"extends": [
		"./biome/base.json",
		"./biome/linter.json",
		"./biome/javascript.json",
		"./biome/overrides/test.json",
		"./biome/overrides/config-files.json"
	],
	"overrides": [
		{
			"includes": [
				"packages/@nunjucks/runtime/src/helpers/suppress-value.ts",
				"packages/@nunjucks/runtime/src/sandbox.ts",
				"packages/@nunjucks/shared/src/error-location.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noExcessiveLinesPerFile": {
							"level": "off",
							"options": {}
						}
					}
				}
			}
		}
	]
}
