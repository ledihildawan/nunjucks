{
	"$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["src/**", "packages/@nunjucks/*/src/**"],
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"includes": ["src/**/*.ts", "packages/@nunjucks/*/src/**/*.ts"],
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedFunctionParameters": "error"
			},
			"style": {
				"noEnum": "error",
				"useImportType": "error",
				"useShorthandFunctionType": "error",
				"useTemplate": "error",
				"useConsistentArrayType": "error",
				"useEnumInitializers": "error",
				"noNonNullAssertion": "off"
			},
			"complexity": {
				"noExtraBooleanCast": "error",
				"noUselessCatch": "error",
				"noUselessConstructor": "error",
				"useOptionalChain": "error",
				"noUselessSwitchCase": "error"
			},
			"suspicious": {
				"noConstEnum": "error",
				"noShadow": "error",
				"noRedeclare": "error",
				"noDuplicateCase": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "es5"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
