{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["packages/@nunjucks/*/src/**/*.ts"],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "project": "all",
      "types": "all"
    },
    "rules": {
      "a11y": "error",
      "style": {
        "useNamingConvention": "off",
        "noExportedImports": "off",
        "noNonNullAssertion": "off",
        "noIncrementDecrement": "off",
        "useDestructuring": "off",
        "useExportsLast": "off",
        "noParameterAssign": "off",
        "noContinue": "off",
        "noSubstr": "off",
        "useTemplate": "off",
        "noExcessiveLinesPerFile": "off",
        "noMagicNumbers": "off",
        "useForOf": "off",
        "useAtIndex": "off",
        "noDefaultExport": "off",
        "useNodejsImportProtocol": "off",
        "useConsistentMethodSignatures": "off",
        "useSymbolDescription": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noExcessiveLinesPerFunction": "off",
        "noForEach": "off",
        "useMaxParams": "off",
        "noBannedTypes": "off"
      },
      "performance": {
        "noBarrelFile": "off",
        "noReExportAll": "off",
        "noAwaitInLoops": "off",
        "noNamespaceImport": "off",
        "useTopLevelRegex": "off"
      },
      "suspicious": {
        "noImportCycles": "off",
        "noExplicitAny": "off",
        "useIterableCallbackReturn": "off",
        "noApproximativeNumericConstant": "off",
        "noShadowRestrictedNames": "off",
        "noAssignInExpressions": "off",
        "noUnnecessaryConditions": "off",
        "noProto": "off",
        "useAwait": "off",
        "noEvolvingTypes": "off",
        "noEmptyBlockStatements": "off",
        "noConsole": "off",
        "noReturnAssign": "off",
        "noImplicitAnyLet": "off",
        "noNonNullAssertedOptionalChain": "off",
        "noConfusingVoidType": "off",
        "noShadow": "off"
      },
      "security": {
        "noSecrets": "off"
      },
      "correctness": {
        "noUndeclaredDependencies": "off",
        "useQwikValidLexicalScope": "off",
        "noNodejsModules": "off",
        "noUnusedVariables": "off",
        "noUnusedImports": "off",
        "noUnresolvedImports": "off"
      },
      "nursery": {
        "useExplicitType": "off",
        "useExplicitReturnType": "off",
        "useNamedCaptureGroup": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
